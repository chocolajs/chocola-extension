{
  "Component scaffold": {
    "prefix": "component",
    "body": [
      "<script>",
      "\texport let ${1:name}${2: = ${3:value}};",
      "",
      "\tfunction \\$runtime() {",
      "\t\t$0",
      "\t}",
      "</script>",
      "",
      "<template>",
      "\t$4",
      "</template>",
      "",
      "<style>",
      "\t:root {",
      "\t\t$5",
      "\t}",
      "</style>"
    ],
    "description": "Full Chocola component scaffold"
  },
  "Script block": {
    "prefix": "script",
    "body": ["<script>", "\t$0", "</script>"],
    "description": "Chocola <script> block"
  },
  "Template block": {
    "prefix": "template",
    "body": ["<template>", "\t$0", "</template>"],
    "description": "Chocola <template> block"
  },
  "Style block": {
    "prefix": "style",
    "body": ["<style>", "\t$0", "</style>"],
    "description": "Chocola <style> block"
  },
  "export let prop": {
    "prefix": "export",
    "body": ["export let ${1:name}${2: = ${3:value}};"],
    "description": "Declare a component prop"
  },
  "$runtime function": {
    "prefix": "runtime",
    "body": ["function \\$runtime() {", "\t$0", "}"],
    "description": "$runtime lifecycle function"
  },
  "self declaration": {
    "prefix": "self",
    "body": ["let self;"],
    "description": "Self element reference declaration"
  },
  "if block": {
    "prefix": "if",
    "body": [
      "<${1:void} if=\"{${2:condition}}\">",
      "\t$0",
      "</${1:void}>"
    ],
    "description": "Conditional display block"
  },
  "del:if block": {
    "prefix": "delif",
    "body": [
      "<${1:void} del:if=\"{${2:condition}}\">",
      "\t$0",
      "</${1:void}>"
    ],
    "description": "Conditional removal block"
  },
  "elif block": {
    "prefix": "elif",
    "body": [
      "<${1:void} elif=\"{${2:condition}}\">",
      "\t$0",
      "</${1:void}>"
    ],
    "description": "Else-if conditional block"
  },
  "else directive": {
    "prefix": "else",
    "body": [
      "<${1:void} else>",
      "\t$0",
      "</${1:void}>"
    ],
    "description": "Else fallback block"
  },
  "void element": {
    "prefix": "void",
    "body": ["<void>", "\t$0", "</void>"],
    "description": "Transparent wrapper element"
  },
  "slot element": {
    "prefix": "slot",
    "body": ["<slot></slot>"],
    "description": "Content projection slot"
  },
  "bind:self": {
    "prefix": "bind:self",
    "body": ["bind:self=\"${1:variableName}\""],
    "description": "Bind element reference to variable"
  },
  "bind property": {
    "prefix": "bind",
    "body": ["bind:${1:property}=\"${2:variableName}\""],
    "description": "Bind element property to variable"
  },
  "import component": {
    "prefix": "import",
    "body": ["import ${1:Component} from \"./${2:path.html}\";$0"]
  },
  "new component": {
    "prefix": "new",
    "body": ["let ${1:newComponent} = new ${Component}();"],
    "description": "Create a new component instance"
  },
  "mount component": {
    "prefix": "mount",
    "body": ["${1:component}().mount(${2:target}, { ${3:props} })"],
    "description": "Mount a component"
  },
  "update component": {
    "prefix": "update",
    "body": ["${1:instance}.update({ ${2:props} })"],
    "description": "Update a mounted component"
  },
  "remove component": {
    "prefix": "remove",
    "body": ["${1:instance}.remove()"],
    "description": "Remove a mounted component"
  },
  "css root element": {
    "prefix": ":root",
    "body": [":root"],
    "description": "The root element of your component"
  }
}
